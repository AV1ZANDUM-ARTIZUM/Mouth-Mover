# Server-side only. NEVER put this value in app.js or index.html.
OPENAI_API_KEY=replace_with_your_server_key

# Optional: the exact origin of your GitHub Pages site, for example:
# https://av1zandum-artizum.github.io
# For the project site, include the repository path:
# https://av1zandum-artizum.github.io/Mouth-Mover
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io/Mouth-Mover

# Optional model override. The backend defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
